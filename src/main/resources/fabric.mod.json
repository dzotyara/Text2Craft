{
  "schemaVersion": 1,
  "id": "llmcraft",
  "version": "${version}",
  "name": "Text2Craft",
  "description": "Generate, preview, and place structures in Text2Craft Studio using local Ollama models.",
  "icon": "assets/llmcraft/icon.png",
  "authors": ["dzotyara"],
  "contact": {"sources": "https://github.com/dzotyara/Text2Craft"},
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.dzotyara.llmcraft.LlmCraft"],
    "client": ["io.github.dzotyara.llmcraft.StudioClient"]
  },
  "mixins": ["llmcraft.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api": "*",
    "minecraft": "1.21.1",
    "java": ">=21"
  }
}
